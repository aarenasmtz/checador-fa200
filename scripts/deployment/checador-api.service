[Unit]
Description=Checador y Asistencia Biometrica .NET 9 API
After=network.target docker.service

[Service]
WorkingDirectory=/var/www/checador-api
ExecStart=/usr/bin/dotnet /var/www/checador-api/Attendance.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=checador-api
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://127.0.0.1:5081
Environment=LOG_FILE_PATH=/var/log/checador/attendance-api-.txt

[Install]
WantedBy=multi-user.target
